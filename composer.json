{
    "name": "blutrixx/nativephp-sms",
    "description": "Default-SMS-app layer for NativePHP Mobile (Android): role request, receive/store/notify, send, read, blocklist.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        { "name": "joelnjoshkibona" }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Blutrixx\\NativephpSms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blutrixx\\NativephpSms\\SmsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
